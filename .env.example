# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives contact form messages
CONTACT_TO_EMAIL=

# Must use an address on your verified Resend domain (not onboarding@resend.dev)
CONTACT_FROM_EMAIL=Portfolio <your mail>

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxx
